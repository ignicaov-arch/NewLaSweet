---
import '../styles/site.css';
import { BRAND } from '../data/brand';
import { buildSiteSchemaGraph } from '../domain/seoSchema';
import { buildWhatsAppUrl, sanitizeUrl } from '../domain/whatsapp';
import CookieConsent from '../components/CookieConsent';
import FooterSection from '../components/FooterSection';
import LogoEmblem from '../components/LogoEmblem';
import WhatsAppFloat from '../components/WhatsAppFloat';

const schemaJson = buildSiteSchemaGraph('home');
const helpWhatsappHref = sanitizeUrl(
  buildWhatsAppUrl(
    'Olá, equipe La Sweet! Acessei um link indisponível no site e gostaria de ver o cardápio.'
  )
);
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Página Não Encontrada | La Sweet Divinópolis</title>
  <meta
    name="description"
    content="A página solicitada não foi encontrada. Volte para o cardápio da La Sweet em Divinópolis ou peça pelo WhatsApp."
  />
  <meta
    name="robots"
    content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  />
  <link rel="canonical" href="https://newlasweet.pages.dev/" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content={BRAND.fullName} />
  <meta property="og:url" content="https://newlasweet.pages.dev/" />
  <meta property="og:title" content="Página Não Encontrada | La Sweet Divinópolis" />
  <meta
    property="og:description"
    content="Confeitaria La Sweet no Centro de Divinópolis: croissants, bombons de morango e presentes."
  />
  <meta property="og:image" content="https://newlasweet.pages.dev/img/og-lasweet-1200x630.webp" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#2B1814" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Instrument+Serif:ital@0;1&display=swap"
    rel="stylesheet"
  />
  <script is:inline type="application/ld+json" set:html={schemaJson.replace(/</g, '\\u003c')} />
</head>
<body>
  <header class="topo is-rolou" id="topo" data-always-scrolled="true">
    <div class="topo__pilula">
      <a class="marca text-current" href="/" style="color: inherit; text-decoration: none;">
        <LogoEmblem size={34} />
        <span>{BRAND.name}</span>
      </a>
      <nav class="menu" aria-label="Principal">
        <a href="/">Início</a>
        <a href="/#cardapio">Cardápio</a>
        <a href="/#encomendar">Pedidos</a>
        <a href="/linkbio">LinkBio</a>
      </nav>
      <a class="botao botao--pequeno topo__cta" href="/#encomendar">Fazer pedido</a>
    </div>
  </header>

  <main class="wrap max-w-4xl" style="padding-top: 140px; padding-bottom: 64px; text-align: center;">
    <section
      style="padding: clamp(32px, 6vw, 60px); border-radius: 28px; background: var(--papel, #fffdf9); border: 1px solid var(--linha, rgba(43, 24, 20, 0.12));"
    >
      <p class="etiqueta"><i aria-hidden="true" />Erro 404 · Página não encontrada</p>
      <h1 class="titulo-m" style="margin-bottom: 18px;">
        Esse endereço saiu do forno, mas <em>nossa vitrine continua pronta.</em>
      </h1>
      <p style="max-width: 600px; margin: 0 auto 28px; color: var(--texto-suave, #694e46);">
        O link que você tentou abrir foi movido ou não existe mais. Volte à página inicial da La
        Sweet, acesse os atalhos no LinkBio ou chame a equipe diretamente no WhatsApp.
      </p>

      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px;">
        <a class="botao" href="/">
          <span>Voltar à página inicial</span>
        </a>
        <a class="botao botao--linha" href="/linkbio">
          <span>Abrir LinkBio</span>
        </a>
        <a
          class="botao botao--escuro text-white"
          href={helpWhatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          style="color: #fffdf9;"
        >
          <span>Pedir no WhatsApp</span>
          <span class="botao__seta" aria-hidden="true">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              strokeLinecap="round"
              strokeLinejoin="round"
            >
              <path d="M5 12h14M13 6l6 6-6 6" vectorEffect="non-scaling-stroke" />
            </svg>
          </span>
        </a>
      </div>
    </section>
  </main>

  <footer class="rodape">
    <FooterSection isHome={false} />
  </footer>
  <CookieConsent />
  <WhatsAppFloat />

  <script>
    import '../scripts/smoothMotion';
    import '../scripts/interactions';
  </script>
</body>
</html>
